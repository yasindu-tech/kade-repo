# Local development defaults. Copy to .env to override. Never commit real secrets.
KADE_DB_NAME=kade
KADE_DB_USER=kade
KADE_DB_PASSWORD=kade
KADE_DB_PORT=5432
KADE_GOTENBERG_PORT=3001

# Read by the API (apps/api/src/main/resources/application.yml)
KADE_DB_URL=jdbc:postgresql://localhost:5432/kade
KADE_GOTENBERG_URL=http://localhost:3001
